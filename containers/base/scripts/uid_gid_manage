# This script creates users/groups for OpenStack service containers.
# User definitions are read from zz_generated_users.txt, which is
# generated from users/registry.go via: make generate-service-uids
#
# Usage:
# ./uid_gid_manage qemu nova
#
# Note: order of args is maintained during the creation.
#

set -o errexit
set -o xtrace

[ -z "$1" ] && echo "Argument missing: name of user to create" && exit 1
_USERS_TO_CREATE=$@

# Path to the generated users registry (plain text, space-delimited)
_REGISTRY="${_REGISTRY:-$(dirname "$0")/zz_generated_users.txt}"

if [ ! -f "$_REGISTRY" ]; then
    echo "ERROR: users registry not found at $_REGISTRY"
    exit 1
fi

for _USER_TO_CREATE in $_USERS_TO_CREATE; do
    # Read user definition: name uid gid home groups
    # home is - if unset, groups is - if unset
    _LINE=$(grep "^${_USER_TO_CREATE} " "$_REGISTRY")
    if [ -z "$_LINE" ]; then
        echo "User ${_USER_TO_CREATE} was not found in the registry ($_REGISTRY)"
        exit 1
    fi

    read _NAME _UID _GID _HOME_DIR _EXTRA_GROUPS <<< "$_LINE"

    # Normalize placeholders
    [ "$_HOME_DIR" = "-" ] && _HOME_DIR=""
    [ "$_EXTRA_GROUPS" = "-" ] && _EXTRA_GROUPS=""

    # Initialize computed args
    _EXTRA_GROUPS_ARG=
    _EXTRA_PERMS=
    _HOME_ARGS=

    if [[ -n "$_EXTRA_GROUPS" ]]; then
        _EXTRA_GROUPS_ARG="--groups $_EXTRA_GROUPS"
    fi

    # Some users don't need a home directory
    if [[ -z "$_HOME_DIR" ]]; then
        _HOME_ARGS="-M"
    else
        _HOME_ARGS="-m --home $_HOME_DIR"
    fi

    if id -g "$_NAME" 2>/dev/null; then
        _GROUPADD_CMD="groupmod --gid $_GID $_NAME"
    else
        _GROUPADD_CMD="groupadd --gid $_GID $_NAME"
    fi

    if id "$_NAME" 2>/dev/null; then
        # -M argument doesn't exist with usermod
        if [[ -z "$_HOME_DIR" ]]; then
            _HOME_ARGS=
        # usermod doesn't guarantee the home directory permissions (best effort)
        else
            _EXTRA_PERMS="&& mkdir -p $_HOME_DIR && chown -R $_UID:$_GID $_HOME_DIR"
        fi
        # --append only exists with usermod
        [[ -n "$_EXTRA_GROUPS_ARG" ]] && _EXTRA_GROUPS_ARG="--append $_EXTRA_GROUPS_ARG"
        _USERADD_CMD="usermod ${_HOME_ARGS} --gid $_GID --uid $_UID ${_EXTRA_GROUPS_ARG} $_NAME ${_EXTRA_PERMS}"
    else
        _USERADD_CMD="useradd -l ${_HOME_ARGS} --shell /usr/sbin/nologin --uid $_UID --gid $_GID ${_EXTRA_GROUPS_ARG} $_NAME"
    fi
    eval $_GROUPADD_CMD
    eval $_USERADD_CMD
done
