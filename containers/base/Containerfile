ARG UBI_BASE_IMAGE=registry.access.redhat.com/ubi10/ubi-minimal:latest

# --- Build stage: compile wheels from source ---
FROM ${UBI_BASE_IMAGE} AS build

ARG CONSTRAINTS_FILE=requirements.lock
COPY ${CONSTRAINTS_FILE} /deps-upper-constraints.txt

# We can force build from source of all packages optionally
ARG PIP_NO_BINARY=""
ENV PIP_NO_BINARY=${PIP_NO_BINARY}

COPY builddeps.txt /tmp/builddeps.txt
RUN pkgs=$(cat /tmp/builddeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    if [ -n "${pkgs}" ]; then microdnf -y install ${pkgs}; microdnf clean all; fi

COPY pythonbuilddeps.txt /tmp/pythonbuilddeps.txt
RUN pkgs=$(cat /tmp/pythonbuilddeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    if [ -n "${pkgs}" ]; then pip3 install --no-cache-dir -c /deps-upper-constraints.txt ${pkgs}; fi

# Second, build the wheels for the dependencies and place them in a different directory
RUN pip3 wheel --no-cache-dir --no-deps \
          --find-links=/wheels/pkgs \
          --wheel-dir=/wheels/deps -r /deps-upper-constraints.txt

# --- Runtime stage ---
FROM ${UBI_BASE_IMAGE}

LABEL maintainer="OpenStack Kubernetes Operator team"

ARG CONSTRAINTS_FILE=requirements.lock

ENV LANG="en_US.UTF-8"
ENV TZ="UTC"
ENV container="oci"
ENV SSL_CERT_FILE=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem
ENV REQUESTS_CA_BUNDLE=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem

USER root

COPY ${CONSTRAINTS_FILE} /deps-upper-constraints.txt
# SKIP IN DOWNSTREAM
COPY rpms.repo /etc/yum.repos.d/rpms.repo

COPY bindeps.txt /tmp/bindeps.txt

# As centos repos enabled with rpms.repo, to avoid conflicts remove ubi repo if exists
RUN if [ -f "/etc/yum.repos.d/ubi.repo" ]; then rm -f /etc/yum.repos.d/ubi.repo && microdnf clean all && rm -rf /var/cache/dnf; fi

# The -so stub from ubi-minimal owns fips.so and conflicts with the real
# openssl-fips-provider package.
# SKIP IN DOWNSTREAM
RUN rpm -e openssl-fips-provider-so --nodeps || true

# Align openssl-libs with CentOS Stream so openssl-fips-provider (see
# bindeps.txt) always installs and images ship fips.so on FIPS nodes
# (OSPRH-39017).
# Align libxml2 too so service builds can install matching libxml2-devel.
# SKIP IN DOWNSTREAM
RUN microdnf -y distro-sync openssl-libs libxml2 && microdnf clean all

RUN pkgs=$(cat /tmp/bindeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    if [ -n "${pkgs}" ]; then microdnf -y install ${pkgs} && microdnf clean all && rm -rf /var/cache/dnf; fi && \
    rm /tmp/bindeps.txt

COPY --from=build /wheels /wheels
COPY pythondeps.txt /tmp/pythondeps.txt
RUN extrapkgs=$(cat /tmp/pythondeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    pip3 install --no-cache-dir --prefix=/usr \
      -c /deps-upper-constraints.txt \
      --find-links=/wheels/deps \
      ${extrapkgs} && \
    rm -rf /wheels /tmp/pythondeps.txt

# DNF configuration
RUN crudini --set /etc/dnf/dnf.conf main clean_requirements_on_remove True && \
    crudini --set /etc/dnf/dnf.conf main exactarch 1 && \
    crudini --set /etc/dnf/dnf.conf main gpgcheck 1 && \
    crudini --set /etc/dnf/dnf.conf main install_weak_deps False && \
    crudini --set /etc/dnf/dnf.conf main tsflags nodocs

# TLS cert symlink
RUN if [ ! -f "/etc/pki/tls/cert.pem" ]; then \
      ln -s /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /etc/pki/tls/cert.pem; \
    fi

# Install kolla helper scripts
COPY scripts/uid_gid_manage /usr/local/bin/uid_gid_manage
COPY scripts/kolla_set_configs /usr/local/bin/kolla_set_configs
COPY scripts/kolla_start /usr/local/bin/kolla_start
COPY scripts/kolla_httpd_setup /usr/local/bin/kolla_httpd_setup
COPY scripts/kolla_copy_cacerts /usr/local/bin/kolla_copy_cacerts
COPY scripts/sudoers /etc/sudoers
RUN chmod 755 /usr/local/bin/uid_gid_manage \
              /usr/local/bin/kolla_set_configs \
              /usr/local/bin/kolla_start \
              /usr/local/bin/kolla_httpd_setup \
              /usr/local/bin/kolla_copy_cacerts && \
    chmod 440 /etc/sudoers

# Create base users/groups (kolla + system groups needed by multiple services)
RUN uid_gid_manage kolla hugetlbfs libvirt qemu
RUN touch /usr/local/bin/kolla_extend_start && \
    chmod 755 /usr/local/bin/kolla_extend_start

# Fix nsswitch.conf
RUN if [ -f "/etc/nsswitch.conf" ]; then sed -ri '/^(passwd:|group:)/ s/systemd//g' /etc/nsswitch.conf; fi
RUN if [ ! -f "/etc/localtime" ]; then ln -s /usr/share/zoneinfo/Etc/UTC /etc/localtime; fi

# Create /openstack directory (convention from tcib)
RUN mkdir -p /openstack

# Final system update
RUN microdnf update -y && microdnf clean all && rm -rf /var/cache/dnf

STOPSIGNAL SIGTERM
ENTRYPOINT ["dumb-init", "--single-child", "--"]
CMD ["kolla_start"]
