# OpenStack Ironic API
#
# This image serves the ironic-api service via WSGI on httpd.

ARG BASE_IMAGE=localhost/openstack/openstack-base:latest

# --- Build stage: compile wheels and collect upstream config ---
FROM ${BASE_IMAGE} AS build

ARG SOURCE_VERSION_STREAM=master
ARG PBR_VERSION_FROM_GIT=false

ARG SERVICE_SRC=/src/ironic

# Copy constraints file and all source repos into the build stage
ARG CONSTRAINTS_FILE=requirements.lock
COPY ${CONSTRAINTS_FILE} /deps-upper-constraints.txt
COPY sources.txt /source-versions/project.txt
COPY src/ /src/
COPY ironic-api/src/ /src/

# We can force build from source of all packages optionally
ARG PIP_NO_BINARY=""
ENV PIP_NO_BINARY=${PIP_NO_BINARY}
# required to build rpds-py from source
ENV MATURIN_NO_INSTALL_RUST=true

COPY ironic-api/builddeps.txt /tmp/builddeps.txt
RUN pkgs=$(cat /tmp/builddeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    if [ -n "${pkgs}" ]; then microdnf -y install ${pkgs} && microdnf clean all; fi

COPY ironic-api/pythonbuilddeps.txt /tmp/pythonbuilddeps.txt
RUN pkgs=$(cat /tmp/pythonbuilddeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    if [ -n "${pkgs}" ]; then pip3 install --no-cache-dir -c /deps-upper-constraints.txt ${pkgs}; fi && \
    rm /tmp/pythonbuilddeps.txt

# Generate a filtered constraints file that excludes packages we build from source.
RUN cp /deps-upper-constraints.txt /tmp/build-constraints.txt && \
    for src_dir in /src/*/ /src/overrides/*/; do \
      if [ -d "${src_dir}" ] && [ -f "${src_dir}/setup.cfg" ]; then \
        pkg_name=$(grep -m1 '^name' "${src_dir}/setup.cfg" | sed 's/.*=\s*//'); \
        sed -i "/^${pkg_name}[=!<>]/Id" /tmp/build-constraints.txt; \
      fi; \
    done

# First build the wheels for the packages themselves
RUN for pkg in /src/*/ /src/overrides/*/; do \
      if [ -d "${pkg}" ] && [ -f "${pkg}/setup.cfg" -o -f "${pkg}/setup.py" -o -f "${pkg}/pyproject.toml" ]; then \
        source_name=$(basename "${pkg%/}"); \
        if [ "${PBR_VERSION_FROM_GIT}" = "true" ] || \
            [ "${pkg#/src/overrides/}" != "${pkg}" ]; then \
          env -u PBR_VERSION pip3 wheel --no-cache-dir --no-deps \
            --wheel-dir=/wheels/pkgs "${pkg}"; \
        else \
          source_version=$(awk -v stream="${SOURCE_VERSION_STREAM}" \
            -v name="${source_name}" \
            '$1 == stream && $2 == name { print $6; exit }' \
            /source-versions/*.txt); \
          PBR_VERSION="${source_version}" pip3 wheel --no-cache-dir --no-deps \
            --no-build-isolation --wheel-dir=/wheels/pkgs "${pkg}"; \
        fi; \
      fi; \
    done

# Second, build the wheels for the dependencies and place them in a different directory
RUN pip3 wheel --no-cache-dir --no-deps \
      --find-links=/wheels/pkgs \
      --wheel-dir=/wheels/deps -r /deps-upper-constraints.txt

RUN for src_dir in /src/*/ /src/overrides/*/; do \
      if [ -d "${src_dir}" ] && [ -f "${src_dir}/setup.cfg" ]; then \
        pkg_name=$(grep -m1 '^name' "${src_dir}/setup.cfg" | sed 's/.*=\s*//'); \
        commit=$(git -C "${src_dir}" rev-parse HEAD 2>/dev/null || echo "unknown"); \
        version=$(ls /wheels/pkgs/${pkg_name//-/_}-*.whl 2>/dev/null | head -1 | sed 's/.*-\([0-9][^-]*\)-.*/\1/' || echo "unknown"); \
        echo "${pkg_name},${commit},${version}"; \
      fi; \
    done > /source-built-packages.txt

ENV PIP_NO_BINARY=""

# Install wheels temporarily so entry points are available for config generation
RUN pip3 install --no-cache-dir --prefix=/usr \
      -c /tmp/build-constraints.txt \
      --find-links=/wheels/deps \
      --find-links=/wheels/pkgs \
      /wheels/pkgs/*.whl

# Generate default config and collect upstream config files
RUN mkdir -p /configfiles/etc/ironic && \
    oslo-config-generator \
      --config-file ${SERVICE_SRC}/tools/config/ironic-config-generator.conf \
      --output-file /configfiles/etc/ironic/ironic.conf && \
    sed -i "/#pybasedir.*/d" /configfiles/etc/ironic/ironic.conf

# Generate WSGI script (ironic master removed wsgi_scripts from setup.cfg)
RUN printf '#!/usr/bin/python3\n\
from ironic.api.wsgi import initialize_wsgi_app\n\
application = initialize_wsgi_app()\n' > /configfiles/ironic-api-wsgi && \
    chmod 755 /configfiles/ironic-api-wsgi

# --- Runtime stage: install from wheels ---
FROM ${BASE_IMAGE}

LABEL summary="OpenStack Ironic API" \
      io.k8s.description="Ironic API service (WSGI via httpd) built from source with kolla interface"

# Create the ironic user (UID 42422)
RUN uid_gid_manage ironic

# Install non-Python system dependencies
COPY ironic-api/bindeps.txt /tmp/bindeps.txt
RUN pkgs=$(cat /tmp/bindeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    if [ -n "${pkgs}" ]; then microdnf -y install ${pkgs} && microdnf clean all; fi && rm /tmp/bindeps.txt

# Install source-built wheels + their deps from PyPI + extra Python deps
COPY --from=build /wheels /wheels
COPY --from=build /tmp/build-constraints.txt /deps-upper-constraints.txt
COPY --from=build /source-built-packages.txt /source-built-packages.txt
COPY ironic-api/pythondeps.txt /tmp/pythondeps.txt
RUN extrapkgs=$(cat /tmp/pythondeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    pip3 install --no-cache-dir --prefix=/usr \
      -c /deps-upper-constraints.txt \
      --find-links=/wheels/deps \
      --find-links=/wheels/pkgs \
      /wheels/pkgs/*.whl ${extrapkgs} && \
    rm -rf /wheels /tmp/pythondeps.txt

# Create required directories
RUN mkdir -p /etc/ironic && \
    mkdir -p /var/log/ironic && chmod 750 /var/log/ironic && \
    mkdir -p /var/lib/ironic && \
    mkdir -p /var/www/cgi-bin/ironic && \
    chown -R ironic:ironic /etc/ironic /var/log/ironic /var/lib/ironic

# Copy WSGI entrypoint for httpd
COPY --from=build /configfiles/ironic-api-wsgi /var/www/cgi-bin/ironic/app

# Install config files — each file listed explicitly
# From upstream source (via build stage):
COPY --from=build /configfiles/etc/ironic/ironic.conf /etc/ironic/ironic.conf
# From common config (repo-maintained):
COPY common/config/etc/ironic/ironic-dist.conf /usr/share/ironic/ironic-dist.conf
COPY common/config/etc/sudoers.d/ironic-sudoers /etc/sudoers.d/ironic

# Set config file permissions
RUN chmod 640 /etc/ironic/ironic.conf && \
    chmod 640 /usr/share/ironic/ironic-dist.conf && \
    chmod 750 /etc/sudoers.d && \
    chmod 440 /etc/sudoers.d/ironic && \
    chown -R ironic:ironic /etc/ironic

# Apache httpd setup for WSGI
RUN sed -i -r 's,^(Listen 80),#\1,' /etc/httpd/conf/httpd.conf && \
    sed -i -r 's,^(Listen 443),#\1,' /etc/httpd/conf.d/ssl.conf 2>/dev/null || true && \
    usermod --append --groups apache ironic

USER ironic
