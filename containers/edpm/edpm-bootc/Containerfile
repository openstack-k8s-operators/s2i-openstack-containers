ARG BASE_IMAGE=localhost/openstack/openstack-base:latest
ARG EDPM_BASE_IMAGE=quay.io/centos-bootc/centos-bootc:stream10

FROM ${BASE_IMAGE} AS repo-setup
FROM ${EDPM_BASE_IMAGE}

COPY --from=repo-setup /etc/yum.repos.d/ /tmp/edpm-yum.repos.d/

# EDPM host packages (from the EDPM bootstrap and DIB elements).
ARG USER_PACKAGES=""
ARG ENABLE_UNITS="openvswitch"

COPY bindeps.txt /tmp/bindeps.txt
RUN DNF_REPO_ARGS="--setopt=reposdir=/tmp/edpm-yum.repos.d" && \
    packages=$(grep -v '^#' /tmp/bindeps.txt | grep -v '^$' | tr '\n' ' ') && \
    dnf -y ${DNF_REPO_ARGS} install ${packages} ${USER_PACKAGES} && \
    . /etc/os-release && if [ "${ID}" = "rhel" ]; then dnf -y ${DNF_REPO_ARGS} install rhoso-release; fi && \
    dnf -y remove dracut-config-generic && \
    dnf clean all && \
    systemctl enable ${ENABLE_UNITS} && \
    rm -rf /tmp/bindeps.txt /tmp/edpm-yum.repos.d

# Configure FIPS.
ARG FIPS=1
RUN if [ "${FIPS}" = "1" ]; then \
      update-crypto-policies --no-reload --set FIPS && \
      mkdir -p /usr/lib/bootc/kargs.d && \
      printf '# Enable FIPS\nkargs = ["fips=1"]\n' > /usr/lib/bootc/kargs.d/01-fips.toml; \
    fi

# Drop the Ansible fact into place.
COPY edpm-bootc/ansible-facts/bootc.fact /etc/ansible/facts.d/bootc.fact
RUN chmod +x /etc/ansible/facts.d/bootc.fact

# Disable automatic update check and reboot.
RUN systemctl mask bootc-fetch-apply-updates.timer

# This should be the last command.
# https://docs.fedoraproject.org/en-US/bootc/building-containers/#_linting
RUN bootc container lint
