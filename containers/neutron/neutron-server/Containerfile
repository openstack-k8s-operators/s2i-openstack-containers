# OpenStack Neutron Server (API, WSGI via httpd, and RPC server)
#
# This image serves neutron-server (API) and neutron-rpc-server.
# The process to run is selected by the config.json "command" field.

ARG BASE_IMAGE=localhost/openstack/openstack-base:latest

# --- Build stage: compile wheels and collect upstream config ---
FROM ${BASE_IMAGE} AS build

ARG SOURCE_VERSION_STREAM=master
ARG PBR_VERSION_FROM_GIT=false

ARG SERVICE_SRC=/src/neutron

# Copy constraints file and all source repos into the build stage
ARG CONSTRAINTS_FILE=requirements.lock
COPY ${CONSTRAINTS_FILE} /deps-upper-constraints.txt
COPY sources.txt /source-versions/project.txt
COPY neutron-server/sources.txt /source-versions/image.txt
COPY src/ /src/
COPY neutron-server/src/ /src/

ARG PIP_NO_BINARY=""
ENV PIP_NO_BINARY=${PIP_NO_BINARY}
# required to build rpds-py from source
ENV MATURIN_NO_INSTALL_RUST=true

COPY builddeps.txt /tmp/builddeps.txt
RUN pkgs=$(cat /tmp/builddeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    if [ -n "${pkgs}" ]; then microdnf -y install ${pkgs} && microdnf clean all; fi

COPY pythonbuilddeps.txt /tmp/pythonbuilddeps.txt
RUN pkgs=$(cat /tmp/pythonbuilddeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    if [ -n "${pkgs}" ]; then pip3 install --no-cache-dir -c /deps-upper-constraints.txt ${pkgs}; fi && \
    rm /tmp/pythonbuilddeps.txt

# Generate a filtered constraints file that excludes packages we build from source.
RUN cp /deps-upper-constraints.txt /tmp/build-constraints.txt && \
    for src_dir in /src/*/ /src/overrides/*/; do \
      if [ -d "${src_dir}" ] && [ -f "${src_dir}/setup.cfg" ]; then \
        pkg_name=$(grep -m1 '^name' "${src_dir}/setup.cfg" | sed 's/.*=\s*//'); \
        sed -i "/^${pkg_name}[=!<>]/Id" /tmp/build-constraints.txt; \
      fi; \
    done

COPY excluded-requirements.txt /tmp/excluded-requirements.txt
RUN sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' /tmp/excluded-requirements.txt | \
    while IFS= read -r pkg; do \
      for req in /src/*/requirements.txt /src/overrides/*/requirements.txt; do \
        if [ -f "${req}" ]; then \
          sed -i -E "/^${pkg}([[:space:]<>=!~;,#[]|\$)/Id" "${req}"; \
        fi; \
      done; \
    done && \
    rm /tmp/excluded-requirements.txt

# Build wheels from all source packages and overrides (neutron, networking-baremetal,
# networking-generic-switch, neutron-fwaas, tap-as-a-service)
RUN for pkg in /src/*/ /src/overrides/*/; do \
      if [ -d "${pkg}" ] && [ -f "${pkg}/setup.cfg" -o -f "${pkg}/setup.py" -o -f "${pkg}/pyproject.toml" ]; then \
        source_name=$(basename "${pkg%/}"); \
        if [ "${PBR_VERSION_FROM_GIT}" = "true" ] || \
            [ "${pkg#/src/overrides/}" != "${pkg}" ]; then \
          env -u PBR_VERSION pip3 wheel --no-cache-dir --no-deps \
            --wheel-dir=/wheels/pkgs "${pkg}"; \
        else \
          source_version=$(awk -v stream="${SOURCE_VERSION_STREAM}" \
            -v name="${source_name}" \
            '$1 == stream && $2 == name { print $6; exit }' \
            /source-versions/*.txt); \
          PBR_VERSION="${source_version}" pip3 wheel --no-cache-dir --no-deps \
            --no-build-isolation --wheel-dir=/wheels/pkgs "${pkg}"; \
        fi; \
      fi; \
    done

# Build wheels for the dependencies and place them in a different directory
RUN pip3 wheel --no-cache-dir --no-deps \
      --find-links=/wheels/pkgs \
      --wheel-dir=/wheels/deps -r /deps-upper-constraints.txt

# Generate build manifest: package-name,commit-hash,version
RUN for src_dir in /src/*/ /src/overrides/*/; do \
      if [ -d "${src_dir}" ] && [ -f "${src_dir}/setup.cfg" ]; then \
        pkg_name=$(grep -m1 '^name' "${src_dir}/setup.cfg" | sed 's/.*=\s*//'); \
        commit=$(git -C "${src_dir}" rev-parse HEAD 2>/dev/null || echo "unknown"); \
        version=$(ls /wheels/pkgs/${pkg_name//-/_}-*.whl 2>/dev/null | head -1 | sed 's/.*-\([0-9][^-]*\)-.*/\1/' || echo "unknown"); \
        echo "${pkg_name},${commit},${version}"; \
      fi; \
    done > /source-built-packages.txt

# Collect upstream config files
RUN mkdir -p /configfiles/etc/neutron/plugins/ml2 && \
    cp -a ${SERVICE_SRC}/etc/neutron/api-paste.ini /configfiles/etc/neutron/ && \
    cp -a ${SERVICE_SRC}/etc/neutron/rootwrap.conf /configfiles/etc/neutron/ && \
    mkdir -p /configfiles/usr/share/neutron/rootwrap && \
    cp -a ${SERVICE_SRC}/etc/neutron/rootwrap.d/rootwrap.filters /configfiles/usr/share/neutron/rootwrap/

# --- Runtime stage: install from wheels ---
FROM ${BASE_IMAGE}

LABEL summary="OpenStack Neutron Server (API, RPC server)" \
      io.k8s.description="Neutron API/RPC server built from source with kolla interface"

# Create the neutron user
RUN uid_gid_manage neutron

# Install non-Python system dependencies
COPY neutron-server/bindeps.txt /tmp/bindeps.txt
RUN pkgs=$(cat /tmp/bindeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    if [ -n "${pkgs}" ]; then microdnf -y install ${pkgs} && microdnf clean all; fi && rm /tmp/bindeps.txt

# Install source-built wheels + deps + extra Python deps
COPY --from=build /wheels /wheels
COPY --from=build /tmp/build-constraints.txt /deps-upper-constraints.txt
COPY --from=build /source-built-packages.txt /source-built-packages.txt
COPY neutron-server/pythondeps.txt /tmp/pythondeps.txt
RUN extrapkgs=$(cat /tmp/pythondeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    pip3 install --no-cache-dir --prefix=/usr \
      -c /deps-upper-constraints.txt \
      --find-links=/wheels/deps \
      --find-links=/wheels/pkgs \
      /wheels/pkgs/*.whl ${extrapkgs} && \
    rm -rf /wheels /tmp/pythondeps.txt

# Create required directories
RUN mkdir -p /etc/neutron/plugins/ml2 /var/lib/neutron /var/run/neutron && \
    mkdir -p /var/log/neutron && chmod 750 /var/log/neutron && \
    chown -R neutron:neutron /etc/neutron /var/lib/neutron /var/run/neutron /var/log/neutron

# Install config files — each file listed explicitly
# From upstream source (via build stage):
COPY --from=build /configfiles/etc/neutron/api-paste.ini /etc/neutron/api-paste.ini
COPY --from=build /configfiles/etc/neutron/rootwrap.conf /etc/neutron/rootwrap.conf
COPY --from=build /configfiles/usr/share/neutron/rootwrap/rootwrap.filters /usr/share/neutron/rootwrap/rootwrap.filters
# From common config (repo-maintained):
COPY common/config/etc/sudoers.d/neutron_sudoers /etc/sudoers.d/neutron_sudoers

# Set config file permissions
RUN chmod 640 /etc/neutron/api-paste.ini /etc/neutron/rootwrap.conf && \
    chmod 750 /etc/sudoers.d && \
    chmod 440 /etc/sudoers.d/neutron_sudoers && \
    chown -R neutron:neutron /etc/neutron

# WSGI script for httpd
RUN mkdir -p /var/www/cgi-bin/neutron
COPY scripts/neutron-wsgi /var/www/cgi-bin/neutron
RUN chown -R neutron /var/www/cgi-bin/neutron && chmod 755 /var/www/cgi-bin/neutron/neutron-wsgi

# Apache httpd setup for WSGI
RUN sed -i -r 's,^(Listen 80),#\1,' /etc/httpd/conf/httpd.conf && \
    sed -i -r 's,^(Listen 443),#\1,' /etc/httpd/conf.d/ssl.conf 2>/dev/null || true && \
    usermod --append --groups apache neutron

USER neutron
